# ─────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения.
# .env в репозиторий не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Postgres (используется и docker-compose, и приложением) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Строка подключения Prisma.
# Пример формы: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=

# --- Бэкенд ---
API_PORT=
API_HOST=
NODE_ENV=

# Домены фронтенда, которым разрешён CORS. Несколько — через запятую.
#
# Адреса хостинга VK Mini Apps сюда вписывать НЕ нужно: они разрешаются
# шаблоном по VK_APP_ID, потому что VK выдаёт новый поддомен на каждую
# боевую выкатку. Здесь — только localhost для разработки и свои домены,
# если они есть.
CORS_ORIGIN=

# --- VK ---
# ID мини-приложения (число из адреса vk.com/app<ID>).
VK_APP_ID=

# ЗАЩИЩЁННЫЙ КЛЮЧ приложения из настроек VK.
# Живёт ТОЛЬКО здесь, на бэкенде. Никогда не попадает на фронтенд,
# в репозиторий и в логи. Оставьте пустым в .env.example.
VK_APP_SECRET=

# --- Локальная разработка вне ВКонтакте ---
# Моковая query-строка launch-параметров: приложение открывается в браузере
# без фрейма VK. Работает ТОЛЬКО при NODE_ENV !== production.
# Сгенерировать: npm run gen:launch-params -w @vk-rideshare/api
VK_MOCK_LAUNCH_PARAMS=

# --- Telegram ---
# Токен бота из BotFather. Он же ключ проверки подписи initData.
# Пока пусто — площадка Telegram выключена: запросы с её заголовком
# получают 401, приложение ВКонтакте работает как работало.
TELEGRAM_BOT_TOKEN=

# --- Разбор жалоб ---
# Кому в приложении виден экран «Жалобы» (профиль → Жалобы).
# Идентификаторы площадок через запятую: VK:123, TG:456 или просто 123 —
# это ВКонтакте. Свой узнать: npm run moderate -w @vk-rideshare/api -- --who <имя>
# Пусто — экран не виден никому, и это правильное значение по умолчанию.
MODERATOR_IDS=

# --- Фронтенд (Vite; всё под префиксом VITE_ попадает в бандл!) ---
# Базовый адрес API. Секретов здесь быть не может по определению.
VITE_API_BASE_URL=

{
  "name": "vk-rideshare",
  "private": true,
  "version": "0.1.0",
  "description": "VK Mini App: поиск попутчиков",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @vk-rideshare/api",
    "dev:web": "npm run dev -w @vk-rideshare/web",
    "build": "npm run build -w @vk-rideshare/shared && npm run build -w @vk-rideshare/api && npm run build -w @vk-rideshare/web",
    "build:server": "npm run build -w @vk-rideshare/shared && npm run build -w @vk-rideshare/api",
    "deploy:web": "npm run deploy -w @vk-rideshare/web",
    "typecheck": "npm run build -w @vk-rideshare/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test -w @vk-rideshare/api && npm run test -w @vk-rideshare/web",
    "db:push": "npm run db:push -w @vk-rideshare/api",
    "db:migrate": "npm run db:migrate -w @vk-rideshare/api",
    "db:seed": "npm run db:seed -w @vk-rideshare/api",
    "moderate": "npm run moderate -w @vk-rideshare/api --",
    "db:studio": "npm run db:studio -w @vk-rideshare/api",
    "db:url": "npm run db:url -w @vk-rideshare/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}

// Схема БД мини-приложения «По пути».
//
// Все денежные значения — целые рубли. Все временные метки — UTC.
// Пользователь опознаётся суррогатным id, а идентификаторы площадок
// (ВКонтакте, Telegram) лежат отдельными колонками — см. модель User.

generator client {
  provider = "prisma-client-js"
}

// В Prisma 7 строка подключения живёт в prisma.config.ts (для CLI)
// и передаётся в PrismaClient драйвер-адаптером (для рантайма).
datasource db {
  provider = "postgresql"
}

/// Роль автора объявления.
enum TripRole {
  /// Автор за рулём и предлагает места.
  DRIVER
  /// Автор ищет, кто его подвезёт.
  PASSENGER
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// На что пожаловались: объявление, отзыв или профиль.
enum ReportTarget {
  TRIP
  REVIEW
  USER
}

/// Причина жалобы. Список закрытый — в интерфейсе это набор пунктов.
enum ReportReason {
  SPAM
  OFFENSIVE
  FRAUD
  PERSONAL_DATA
  OTHER
}

/// Что с жалобой сделала администрация сервиса.
enum ReportStatus {
  NEW
  REVIEWED
  DISMISSED
}

/// Человек, независимо от площадки, через которую он пришёл.
///
/// Первичный ключ суррогатный, а не идентификатор площадки. Так сделано
/// потому, что один и тот же человек может прийти из ВКонтакте, из
/// Telegram или из обоих сразу, и привязка строки к одной площадке
/// закрывала бы дорогу остальным. Идентификаторы площадок лежат
/// отдельными необязательными колонками: заполнена хотя бы одна.
///
/// Профиль (имя, фото, город) кэшируется с той площадки, через которую
/// человек вошёл в последний раз, и обновляется на каждом POST /api/session.
model User {
  id          String   @id @default(cuid())
  /// Идентификатор ВКонтакте. Пусто у тех, кто пришёл только из Telegram.
  vkUserId    BigInt?  @unique
  /// Идентификатор Telegram. Пусто у тех, кто пришёл только из ВКонтакте.
  tgUserId    BigInt?  @unique
  firstName   String
  lastName    String
  photoUrl    String?
  city        String?
  /// Мобильный в виде +7XXXXXXXXXX. Показывается как способ связи; не указан — кнопки «Позвонить» нет.
  phone       String?
  /// Средняя оценка по полученным отзывам; пересчитывается в транзакции отзыва.
  /// Когда принята политика конфиденциальности. Пусто — согласия не было,
  /// и тогда у человека не должно быть ни этой строки, ни чего-либо ещё.
  privacyAcceptedAt DateTime?
  /// Когда администрация закрыла доступ за нарушение правил. Пусто — доступ открыт.
  ///
  /// Отметка, а не удаление: удалив нарушителя, мы потеряли бы и причину,
  /// и возможность узнать его при следующем заходе — идентификатор
  /// площадки у него тот же.
  blockedAt         DateTime?
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  createdAt   DateTime @default(now())

  trips          Trip[]        @relation("TripAuthor")
  requests       TripRequest[]
  reviewsWritten Review[]      @relation("ReviewAuthor")
  reviewsGot     Review[]      @relation("ReviewTarget")
  reportsSent    Report[]      @relation("ReportAuthor")

  @@map("users")
}

model Trip {
  id         String     @id @default(cuid())
  authorId   String
  role       TripRole
  fromCity   String
  fromPoint  String?
  toCity     String
  toPoint    String?
  departAt   DateTime
  seatsTotal Int
  /// Уменьшается только условным UPDATE ... WHERE seatsLeft > 0 внутри транзакции.
  seatsLeft  Int
  /// Цена за место. Обязательна: коридор задан продуктом (см. LIMITS).
  priceRub   Int
  carModel   String?
  comment    String?
  status     TripStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())

  author   User          @relation("TripAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  requests TripRequest[]
  reviews  Review[]

  @@index([fromCity, toCity, departAt])
  @@index([status])
  @@index([authorId, status])
  @@index([departAt, id])
  @@map("trips")
}

model TripRequest {
  id        String        @id @default(cuid())
  tripId    String
  userId    String
  status    RequestStatus @default(PENDING)
  message   String?
  createdAt DateTime      @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId, status])
  @@map("trip_requests")
}

model Review {
  id         String   @id @default(cuid())
  tripId     String
  authorId   String
  targetId   String
  /// 1..5 — проверяется Zod-схемой на входе.
  rating     Int
  text       String?
  createdAt  DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([tripId, authorId, targetId])
  @@index([targetId])
  @@map("reviews")
}

/// Жалоба на пользовательский контент.
///
/// Контент в сервисе появляется сразу, без предварительной проверки:
/// поездку нужно найти сегодня, а не после модерации. Значит, проверка
/// постфактум, и у неё должен быть вход — эта таблица.
///
/// `targetId` нарочно не внешний ключ. Жалоба указывает на один из трёх
/// разных объектов, и ссылку на «одну из трёх таблиц» в реляционной
/// схеме выразить нечем: пришлось бы либо держать три необязательные
/// колонки, либо три таблицы. Платим за это тем, что удалённое
/// объявление оставляет жалобу с повисшим идентификатором — и это
/// скорее хорошо: запись о разборе должна переживать удаление того, на
/// что жаловались.
///
/// Уникальность по (кто, на что) превращает повторное нажатие в 409
/// вместо горы одинаковых строк. Накрутить счётчик жалобами с разных
/// аккаунтов она не мешает, но счётчик тут ничего и не решает: жалобы
/// разбирает человек.
model Report {
  id         String       @id @default(cuid())
  reporterId String
  target     ReportTarget
  /// Идентификатор поездки, отзыва или пользователя — смотря что в target.
  targetId   String
  /// Автор того, на что пожаловались, на момент жалобы.
  ///
  /// Дублирует то, что можно вычислить по targetId, — и в этом весь
  /// смысл: разобрав жалобу, мы удаляем контент, и вычислять становится
  /// не из чего. Без этой колонки нельзя даже вернуть доступ тому, кого
  /// закрыли по ошибке: автор уже неизвестен.
  ///
  /// Необязательная и без внешнего ключа: у жалоб, заведённых до
  /// появления колонки, автора взять неоткуда, а удаление учётной записи
  /// не должно уносить с собой запись о разборе.
  ownerId    String?
  reason     ReportReason
  /// Пояснение от пожаловавшегося. Обязательно при причине OTHER — проверяется Zod-схемой.
  comment    String?
  status     ReportStatus @default(NEW)
  createdAt  DateTime     @default(now())

  reporter User @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, target, targetId])
  /// Рабочий запрос администрации: «что нового, по времени».
  @@index([status, createdAt])
  @@index([target, targetId])
  @@map("reports")
}

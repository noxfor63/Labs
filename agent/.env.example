# ============================================================
#  Настройки агента канала «По пути». Скопируйте в agent/.env и заполните.
#  .env не попадает в git — ключи не утекут.
#  Подробно, по шагам — agent/README.md.
# ============================================================

# --- Claude ---------------------------------------------------------
# Ключ напрямую от Anthropic…
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE
# …или через посредника, как у MetodiLabs (тогда ANTHROPIC_API_KEY оставьте как есть):
# ANTHROPIC_BASE_URL=https://api.smartapi.pro
# ANTHROPIC_AUTH_TOKEN=ключ-посредника

# Модель. Посты короткие, Sonnet пишет их не хуже Opus и вдвое дешевле.
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium

# --- Telegram -------------------------------------------------------
# Токен ОТДЕЛЬНОГО бота от @BotFather — не @po_puti56_bot. Почему — README, шаг 1.
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID: бот сам его подскажет на /start. Только эти люди видят черновики
# и могут нажать «Опубликовать». Несколько — через запятую.
TELEGRAM_ALLOWED_USERS=
# Канал, куда публиковать. Бот должен быть его администратором с правом публикации.
TELEGRAM_CHANNEL=@po_puti56
# Как подключаться к Telegram: пусто — как в системе, none — напрямую, или адрес прокси:
#   socks5h://логин:пароль@адрес:порт  — SOCKS5 (h — адрес Telegram разрешает прокси)
#   http://127.0.0.1:10809             — Xray с VLESS-ключом (README, часть 3, шаг 0)
# TELEGRAM_PROXY=

# Кнопка под постом. Пустой POST_BUTTON_URL не сделает кнопку пустой — подставится адрес по умолчанию.
POST_BUTTON_TEXT=Открыть «По пути»
POST_BUTTON_URL=https://t.me/po_puti56_bot/app

# --- Источники -------------------------------------------------------
# API «По пути» вместе с /api и ключ агента — тот же, что AGENT_API_TOKEN в .env сервера.
PP_API_URL=https://vk-rideshare.duckdns.org/api
PP_API_TOKEN=
# Репозиторий, за обновлениями которого следить. Ветка пустая — ветка по умолчанию.
PP_REPO=noxfor63/Labs
# PP_REPO_BRANCH=
# Нужен, только если репозиторий закрытый: fine-grained токен с правом Contents: Read.
# GITHUB_TOKEN=
# С какого момента считать обновления при самом первом запуске (ISO-дата).
# Пусто — с того, что выкачено сейчас: прошлое агент не пересказывает.
# AGENT_UPDATES_SINCE=2026-10-13T00:00:00Z

# --- Обход по расписанию --------------------------------------------
# Раз в сколько часов смотреть, нет ли повода для поста.
AGENT_SCAN_INTERVAL_HOURS=6
# В какие часы обход разрешён — черновик не должен приходить ночью.
AGENT_ACTIVE_HOURS=9-21
AGENT_TIMEZONE=Asia/Yekaterinburg
# Сколько черновиков может ждать решения одновременно.
AGENT_MAX_PENDING_DRAFTS=3
